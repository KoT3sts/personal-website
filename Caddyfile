{
	admin off
	auto_https off
}

:{$PORT:8080} {
	root * /srv
	encode zstd gzip

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Strict-Transport-Security "max-age=31536000"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
		X-Frame-Options "DENY"
		-Server
	}

	# Pages are revalidated on every visit; everything else can be cached for an hour.
	@pages path / *.html
	header @pages Cache-Control "no-cache"
	@static not path / *.html
	header @static Cache-Control "public, max-age=3600"

	@manifest path *.webmanifest
	header @manifest Content-Type "application/manifest+json; charset=utf-8"

	try_files {path} {path}.html
	file_server

	handle_errors {
		@notfound expression {err.status_code} == 404
		handle @notfound {
			rewrite * /404.html
			file_server
		}
	}
}
